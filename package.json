{
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:ai": "ai/.venv/bin/uvicorn app.main:app --app-dir ai --reload --host 0.0.0.0 --port 8000",
    "ai:download": "ai/.venv/bin/python -m ai.training.download_dataset --output ai/data/raw",
    "ai:train": "ai/.venv/bin/python -m ai.training.train --data 'ai/data/raw/Citra BISINDO' --manifest ai/data/splits/manifest.json --output ai/models/candidates --augmentations 12",
    "ai:evaluate": "ai/.venv/bin/python -m ai.training.evaluate --manifest ai/data/splits/manifest.json --old-model ai/models/rf_bisindo_99.pkl --new-model ai/models/candidates/extra_trees_normalized.pkl --output ai/reports/model_comparison.json",
    "build:frontend": "npm --prefix frontend run build",
    "lint:frontend": "npm --prefix frontend run lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.1"
  }
}
