BISINDO_MODEL_PATH=models/bisindo_geometry_v6.pkl
AI_CORS_ORIGINS=http://localhost:4789,http://127.0.0.1:4789
AI_MAX_IMAGE_BYTES=2000000
AI_MIN_DETECTION_CONFIDENCE=0.5
AI_MIN_TRACKING_CONFIDENCE=0.5
# Smallest hand accepted, as a fraction of frame width. Below this MediaPipe
# landmarks are too coarse to tell P from Q.
BISINDO_MIN_HAND_SPAN=0.06
