# ============================================================
# SignLearn Frontend — konfigurasi
# Salin ke .env:   cp .env.example .env
# ============================================================

# ─── Backend API ─────────────────────────────────────────────
# WAJIB memuat prefix versi `/api/v1`, dan port-nya harus sama dengan
# `PORT` di backend/.env (bawaan: 4788).
#
# Salah satu dari dua kesalahan ini membuat login DAN register gagal:
#   · port keliru        → permintaan tidak sampai ke backend
#   · prefix tanpa /v1   → setiap rute menjadi 404
VITE_API_BASE_URL=http://localhost:4788/api/v1

# Batas waktu permintaan (milidetik)
VITE_API_TIMEOUT_MS=10000

# ─── Mode mock ───────────────────────────────────────────────
# ⚠ HARUS `false` untuk pengembangan normal.
#
# Saat `true`, seluruh pemanggilan API mengembalikan data palsu tanpa pernah
# menyentuh jaringan — termasuk login dan register, yang lalu gagal dengan
# pesan "Tidak dapat terhubung ke server". Pesan itu MENYESATKAN: jaringannya
# baik-baik saja, yang aktif hanyalah flag ini.
#
# Nyalakan hanya sebagai jaring pengaman presentasi bila backend benar-benar
# mati, dan matikan lagi segera sesudahnya.
VITE_API_MOCK_MODE=false

# ─── Layanan AI BISINDO ──────────────────────────────────────
# Kosongkan saat development agar request memakai proxy Vite /bisindo-ai
# (diteruskan ke http://127.0.0.1:8000). Isi URL publik saat production.
VITE_BISINDO_AI_URL=
VITE_BISINDO_CAPTURE_INTERVAL_MS=90
VITE_BISINDO_UNCERTAIN_CONFIDENCE=0.40
VITE_BISINDO_MIN_CONFIDENCE=0.50
VITE_BISINDO_MIN_MARGIN=0.05
VITE_BISINDO_HIGH_CONFIDENCE=0.80
VITE_BISINDO_HIGH_CONFIDENCE_MIN_MARGIN=0.03
VITE_BISINDO_PREDICTION_WINDOW=5
VITE_BISINDO_MINIMUM_VOTES=3
VITE_BISINDO_STABLE_DURATION_MS=180
VITE_BISINDO_FAST_CONFIDENCE=0.85
VITE_BISINDO_FAST_MARGIN=0.15
VITE_BISINDO_FAST_VOTES=2
VITE_BISINDO_FAST_WINDOW=3
VITE_BISINDO_KEEP_CONFIDENCE=0.40
VITE_BISINDO_RELEASE_DURATION_MS=180
VITE_BISINDO_RELEASE_VOTES=2
VITE_BISINDO_DUPLICATE_COOLDOWN_MS=250
VITE_BISINDO_SMOOTHING_ALPHA=0.45
VITE_BISINDO_MAX_OUTPUT_LENGTH=500
VITE_BISINDO_DEBUG=false
