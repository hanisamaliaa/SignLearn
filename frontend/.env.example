# Backend API base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=10000

# Use the frontend's local mock data instead of the backend API
VITE_API_MOCK_MODE=true

# BISINDO realtime inference service
# Kosongkan saat development agar request memakai proxy Vite /bisindo-ai.
# Isi URL publik layanan AI saat production deploy.
VITE_BISINDO_AI_URL=
VITE_BISINDO_CAPTURE_INTERVAL_MS=90
VITE_BISINDO_UNCERTAIN_CONFIDENCE=0.40
VITE_BISINDO_MIN_CONFIDENCE=0.50
VITE_BISINDO_MIN_MARGIN=0.05
VITE_BISINDO_HIGH_CONFIDENCE=0.80
VITE_BISINDO_HIGH_CONFIDENCE_MIN_MARGIN=0.03
VITE_BISINDO_PREDICTION_WINDOW=5
VITE_BISINDO_MINIMUM_VOTES=3
VITE_BISINDO_STABLE_DURATION_MS=180
VITE_BISINDO_FAST_CONFIDENCE=0.85
VITE_BISINDO_FAST_MARGIN=0.15
VITE_BISINDO_FAST_VOTES=2
VITE_BISINDO_FAST_WINDOW=3
VITE_BISINDO_KEEP_CONFIDENCE=0.40
VITE_BISINDO_RELEASE_DURATION_MS=180
VITE_BISINDO_RELEASE_VOTES=2
VITE_BISINDO_DUPLICATE_COOLDOWN_MS=250
VITE_BISINDO_SMOOTHING_ALPHA=0.45
VITE_BISINDO_MAX_OUTPUT_LENGTH=500
VITE_BISINDO_DEBUG=false
