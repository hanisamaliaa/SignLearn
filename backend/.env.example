# ============================================================
# SignLearn Backend — konfigurasi
# Salin ke .env lalu isi. JANGAN commit .env.
# ============================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ─── Database (Supabase PostgreSQL) ──────────────────────────
# Supabase → Project Settings → Database → Connection string
#
# PAKAI YANG INI — Direct connection, port 5432.
# Salin persis seperti yang ditampilkan Supabase, ganti [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<ref>.supabase.co:5432/postgres

# Supabase menawarkan dua jenis koneksi. Bedanya penting:
#
#   Direct (5432)   db.<ref>.supabase.co
#                   Untuk server yang berjalan terus — seperti backend ini.
#                   Mendukung prepared statement, transaksi, session state.
#
#   Pooler (6543)   aws-0-<region>.pooler.supabase.com
#                   Untuk serverless/edge yang membuka-tutup koneksi terus.
#                   TIDAK mendukung prepared statement.
#
# Backend ini adalah proses Express yang hidup terus dan memakai transaksi
# (rotasi refresh token, reset kata sandi), jadi DIRECT yang benar.
#
# ⚠ Password dengan karakter spesial WAJIB di-percent-encode:
#     @ → %40    # → %23    $ → %24    % → %25    & → %26    / → %2F
#   Tanpa itu, URL terpotong di karakter tersebut dan errornya menyesatkan.
#
# ⚠ Bila direct connection gagal dengan ENETUNREACH atau ENOTFOUND:
#   sebagian region Supabase hanya melayani direct lewat IPv6. Bila jaringanmu
#   belum IPv6, pakai pooler (6543) sebagai gantinya — semua tetap berfungsi,
#   hanya prepared statement yang tidak dipakai.

DB_POOL_MAX=10
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# ─── JWT ─────────────────────────────────────────────────────
# WAJIB minimal 32 karakter. Server MENOLAK START bila lebih pendek.
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=signlearn
JWT_AUDIENCE=signlearn-web

# ─── Refresh token ───────────────────────────────────────────
REFRESH_TTL_DAYS=7
REFRESH_COOKIE_NAME=slr_rt

# ─── Cookie ──────────────────────────────────────────────────
# COOKIE_SECURE wajib true di produksi (HTTPS).
# SameSite: 'strict' di produksi, 'lax' di dev agar Vite di port berbeda tetap jalan.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.signlearn.app

# ─── Keamanan ────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# ─── CORS ────────────────────────────────────────────────────
# WAJIB di produksi — cookie kredensial tidak bekerja dengan origin wildcard.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate limit global ───────────────────────────────────────
# Batas ketat untuk endpoint auth di-hardcode di rateLimit.middleware.js.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Seed ────────────────────────────────────────────────────
# Kredensial admin awal. Bila SEED_ADMIN_PASSWORD kosong, `npm run seed`
# MEMBANGKITKAN kata sandi acak kuat dan menampilkannya SEKALI — tidak ada
# kredensial default yang diketahui publik.
#
# Kata sandi wajib lolos passwordPolicy DAN tidak boleh memuat bagian dari
# email/nama admin — "Admin123!" akan ditolak karena memuat "admin".
SEED_ADMIN_EMAIL=admin@signlearn.local
SEED_ADMIN_NAME=Administrator
# SEED_ADMIN_PASSWORD=

# ─── Fitur AI (API Contract §10.8) ───────────────────────────
# Default mati. Endpoint /admin/ai/** tetap ada dan dijaga admin, tetapi
# membalas 501 NOT_IMPLEMENTED sampai integrasinya benar-benar dikerjakan.
AI_SUBTITLE_ENABLED=false
AI_QUIZ_GENERATOR_ENABLED=false
