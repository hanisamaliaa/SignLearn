# ============================================================
# SignLearn Backend — konfigurasi
# Salin ke .env lalu isi. JANGAN commit .env.
# ============================================================

NODE_ENV=development

# ─── Port ────────────────────────────────────────────────────
# Sengaja BUKAN 3000/4000/5000/8080.
#
# Port 5000 khususnya beracun: di macOS ia dipakai AirPlay Receiver, sehingga
# permintaan ke sana dijawab 403 oleh layanan tak berhubungan alih-alih
# ditolak bersih — dan penyebabnya nyaris mustahil ditebak dari pesan error.
#
# Bila diubah, `VITE_API_BASE_URL` di frontend/.env WAJIB ikut berubah.
PORT=4788
API_PREFIX=/api/v1

# ─── Midtrans Payment ───────────────────────────────────────
# Dapatkan dari Midtrans Dashboard → Settings → Access Keys
# Sandbox: SB-Mid-server-XXXXX (server key)
# Produksi: Mid-server-XXXXX (server key)
# ⚠ Server key hanya digunakan di backend, JANGAN pernah taruh di frontend.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Cloudinary (semua upload gambar)
# Ambil dari Cloudinary Console. Ketiga nilai wajib di production.
# API secret hanya boleh berada di backend; jangan pernah memakai VITE_*.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=signlearn
UPLOAD_IMAGE_MAX_BYTES=5242880

# URL frontend untuk callback setelah pembayaran
# Harus sesuai dengan port Vite dev server (default 4789)
FRONTEND_URL=http://localhost:4789

# ─── Database (Supabase PostgreSQL) ──────────────────────────
# Supabase → Project Settings → Database → Connection string
#
# PAKAI POOLER PORT 6543 — transaction mode.
# Salin dari Supabase, ganti [YOUR-PASSWORD]. Perhatikan PORT-nya 6543.
DATABASE_URL=postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase menawarkan tiga cara menyambung. Bedanya menentukan apakah tim
# bisa bekerja bersamaan atau saling mengunci:
#
#   Direct (5432)   db.<ref>.supabase.co
#                   Koneksi langsung. Ideal bila jaringanmu mendukung IPv6.
#
#   Pooler SESSION (5432)  aws-0-<region>.pooler.supabase.com
#                   ⚠ JANGAN untuk pengembangan bersama. Setiap klien menahan
#                   satu koneksi selama sesinya hidup, dan batasnya hanya
#                   15 KLIEN untuk SELURUH proyek. Dengan DB_POOL_MAX=10,
#                   dua orang yang menjalankan backend bersamaan sudah
#                   menghabiskannya, dan semua endpoint membalas 500
#                   `EMAXCONNSESSION`. Lebih buruk lagi: mematikan server
#                   dengan paksa (Ctrl-C ganda, taskkill /F) meninggalkan
#                   sesi menggantung yang baru dilepas beberapa menit
#                   kemudian — jadi kesalahannya terasa acak.
#
#   Pooler TRANSACTION (6543)  aws-0-<region>.pooler.supabase.com
#                   ✅ Yang dipakai proyek ini. Koneksi hanya dipinjam selama
#                   satu transaksi lalu dikembalikan, sehingga beberapa orang
#                   dapat bekerja bersamaan tanpa saling menghabiskan slot.
#
# `withTransaction` (rotasi refresh token, reorder pelajaran/soal) tetap
# bekerja normal di mode transaksi: pgbouncer menyematkan koneksi selama
# BEGIN..COMMIT berlangsung. Yang tidak didukung adalah prepared statement
# BERNAMA — dan kode ini tidak memakainya sama sekali (node-postgres hanya
# membuatnya bila query diberi properti `name`).
#
# ⚠ Password dengan karakter spesial WAJIB di-percent-encode:
#     @ → %40    # → %23    $ → %24    % → %25    & → %26    / → %2F
#   Tanpa itu, URL terpotong di karakter tersebut dan errornya menyesatkan.

# Jaga tetap kecil selama database dipakai bersama satu tim: setiap orang
# yang menjalankan backend memakan jatah dari kuota yang sama.
DB_POOL_MAX=3
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# ─── JWT ─────────────────────────────────────────────────────
# WAJIB minimal 32 karakter. Server MENOLAK START bila lebih pendek.
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=signlearn
JWT_AUDIENCE=signlearn-web

# ─── Refresh token ───────────────────────────────────────────
REFRESH_TTL_DAYS=7
REFRESH_COOKIE_NAME=slr_rt

# ─── Cookie ──────────────────────────────────────────────────
# COOKIE_SECURE wajib true di produksi (HTTPS).
# SameSite: 'strict' di produksi, 'lax' di dev agar Vite di port berbeda tetap jalan.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.signlearn.app

# ─── Keamanan ────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Kode reset enam digit hanya punya sejuta kemungkinan, jadi jendelanya pendek.
PASSWORD_RESET_TTL_MINUTES=15
# Kode dibakar setelah sekian tebakan salah.
PASSWORD_RESET_MAX_ATTEMPTS=5

# ─── Pengiriman email (kode reset kata sandi) ────────────────────────────
#
# SMTP_HOST kosong = mode log: email dicetak ke konsol dan TIDAK dikirim.
# Itu sengaja, supaya pengembangan berjalan tanpa kredensial. Di produksi
# tanpa host ini, pengguna yang lupa kata sandinya tidak punya jalan masuk.
#
# Gmail menuntut App Password (bukan sandi akun) dan 2FA aktif:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
# Kosongkan untuk mengikuti port: 465 memakai TLS implisit, 587 STARTTLS.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# HARUS memakai alamat akun SMTP di atas (atau alias "Send mail as" yang sudah
# diverifikasi). Gmail menulis ulang alamat yang tidak cocok menjadi akun yang
# terautentikasi, jadi alamat karangan seperti no-reply@signlearn.local tidak
# akan pernah muncul — dan pada penyedia lain ia gagal SPF/DKIM lalu masuk spam.
MAIL_FROM="SignLearn <akunmu@gmail.com>"

# ─── CORS ────────────────────────────────────────────────────
# WAJIB di produksi — cookie kredensial tidak bekerja dengan origin wildcard.
#
# Nilai ini harus MEMUAT origin dev server frontend (lihat `server.port` di
# frontend/vite.config.js, bawaan 4789). Bila tidak cocok, browser memblokir
# responsnya dan login gagal dengan galat CORS — bukan galat kredensial,
# sehingga mudah disalahartikan sebagai "kata sandi salah".
#
# 127.0.0.1 dan localhost adalah origin BERBEDA bagi browser; keduanya
# dicantumkan supaya membuka alamat mana pun tetap bekerja.
CORS_ORIGINS=http://localhost:4789,http://127.0.0.1:4789

# ─── Rate limit global ───────────────────────────────────────
# Batas ketat untuk endpoint auth di-hardcode di rateLimit.middleware.js.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Seed ────────────────────────────────────────────────────
# Kredensial admin awal. Bila SEED_ADMIN_PASSWORD kosong, `npm run seed`
# MEMBANGKITKAN kata sandi acak kuat dan menampilkannya SEKALI — tidak ada
# kredensial default yang diketahui publik.
#
# Kata sandi wajib lolos passwordPolicy DAN tidak boleh memuat bagian dari
# email/nama admin — "Admin123!" akan ditolak karena memuat "admin".
SEED_ADMIN_EMAIL=admin@signlearn.local
SEED_ADMIN_NAME=Administrator
# SEED_ADMIN_PASSWORD=

# ─── Fitur AI (API Contract §10.8) ───────────────────────────
# Default mati. Endpoint /admin/ai/** tetap ada dan dijaga admin, tetapi
# membalas 501 NOT_IMPLEMENTED sampai integrasinya benar-benar dikerjakan.
AI_SUBTITLE_ENABLED=false
AI_QUIZ_GENERATOR_ENABLED=false
