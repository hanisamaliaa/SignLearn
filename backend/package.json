{
  "name": "signlearn-backend",
  "version": "1.0.0",
  "description": "SignLearn BISINDO learning platform — REST API backend",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/database/seed.js",
    "smoke": "node scripts/smoke-auth.mjs",
    "db:schema": "psql \"$DATABASE_URL\" -f src/database/schema.sql",
    "gen:secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\""
  },
  "keywords": [
    "signlearn",
    "bisindo",
    "api",
    "express",
    "rest",
    "postgresql"
  ],
  "author": "SignLearn",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
