# ============================================================
# SignLearn Backend — konfigurasi
# Salin ke .env lalu isi. JANGAN commit .env.
# ============================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1


DATABASE_URL=postgresql://postgres.ztuskpsdqjwexkawbbrm:SignLearn505!@aws-0-ap-south-1.pooler.supabase.com:5432/postgres


DB_POOL_MAX=10
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# ─── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=a767ceffd15daab0832b3ee02d4827abd4f57af42f00112824927fbc495a4d045ab61f1a349bc83c4c2f87090cce35fc
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=signlearn
JWT_AUDIENCE=signlearn-web

# ─── Refresh token ───────────────────────────────────────────
REFRESH_TTL_DAYS=7
REFRESH_COOKIE_NAME=slr_rt

# ─── Cookie ──────────────────────────────────────────────────
# COOKIE_SECURE wajib true di produksi (HTTPS).
# SameSite: 'strict' di produksi, 'lax' di dev agar Vite di port berbeda tetap jalan.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.signlearn.app

# ─── Keamanan ────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# ─── CORS ────────────────────────────────────────────────────

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
